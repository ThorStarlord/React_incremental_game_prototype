{
  "name": "incremental-rpg",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.3",
    "@mui/material": "^6.4.3",
    "@reduxjs/toolkit": "^2.6.1",
    "cross-env": "^7.0.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-redux": "^9.2.0",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.0.0",
    "react-scripts": "^5.0.1",
    "react-tsparticles": "^2.12.2",
    "tsparticles": "^3.8.1",
    "tsparticles-engine": "^2.12.0",
    "typescript": "^4.9.5",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "docs:authority:validate": "node scripts/validate-documentation-authority.js",
    "content:audit": "node scripts/content-intelligence/content-audit.js",
    "content:reachability": "node scripts/content-intelligence/reachability-check.js",
    "route:trace": "node scripts/content-intelligence/route-trace.js",
    "content:intelligence:selftest": "node scripts/content-intelligence/selftest.js",
    "content:intelligence:validate": "node scripts/content-intelligence/selftest.js && node scripts/content-intelligence/content-audit.js && node scripts/content-intelligence/reachability-check.js && node scripts/content-intelligence/route-trace.js --target valerius_m25_public_order_conclusion && node scripts/content-intelligence/route-trace.js --target gronk_m25_quiet_network_conclusion",
    "chapter:validate": "cross-env CI=true react-scripts test --watchAll=false --runInBand ChapterDefinitionIntegrity.test.ts",
    "simulated-review:validate": "node --check scripts/simulated-product-review/ui-observer.js && node --check scripts/simulated-product-review/action-contract.js && node --check scripts/simulated-product-review/validate-action-contract.js && node --check scripts/simulated-product-review/validate-config.js && node scripts/simulated-product-review/validate-config.js",
    "simulated-review:action-contract": "node scripts/simulated-product-review/validate-action-contract.js",
    "simulated-review:observe": "node scripts/simulated-product-review/ui-observer.js",
    "simulated-review:smoke": "node scripts/simulated-product-review/ui-observer.js --smoke --headless --url http://127.0.0.1:3000 --out .simulated-review-output/ci-smoke"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "jest": "^27.5.1",
    "playwright": "^1.63.0"
  }
}
