      "npcId": "npc_lyra",
      "title": "Prepare the Distributed Counterphase",
      "text": "Your Chapter 6 distributed network posture defines what can be prepared, but it does not choose the finale plan for you. Lyra asks whether you want to turn that posture into an explicit counterphase preparation.",
      "repeatable": false,
      "requiredExperienceIds": [
        "lyra_gc08_exp_commit_distributed"
      ],
      "requiredWorldState": [
